
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Движения.ВКМ_НачислениеОтпуска.Записывать = Истина;
	
	Для Каждого Строка Из ОтпускаСотрудников Цикл
		
		Движение = Движения.ВКМ_НачислениеОтпуска.ДобавитьПриход();
		Движение.Сотрудник = Строка.Сотрудник;
		Движение.Период = Дата;
		РазностьДат = Строка.ДатаОкончания - Строка.ДатаНачала;
		Движение.КоличествоДней = РазностьДат / 86400;
		
	КонецЦикла;

КонецПроцедуры
